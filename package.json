{
  "name": "@onlymoein/liquidglass",
  "version": "0.15.0",
  "description": "Apple's iOS 27 Liquid Glass for React.",
  "keywords": [
    "react",
    "liquid glass",
    "ios 27",
    "glass",
    "ui",
    "components",
    "tab bar",
    "toolbar",
    "switch",
    "slider",
    "menu"
  ],
  "license": "MIT",
  "author": "Moein Saharkhiz (https://github.com/onlymoein)",
  "contributors": [
    "Kelvin Zhang <me@kelvinzhang.ca> (https://github.com/0kzh)"
  ],
  "homepage": "https://github.com/onlymoein/liquidglass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlymoein/liquidglass.git"
  },
  "bugs": "https://github.com/onlymoein/liquidglass/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "npm run build && vite demo",
    "demo:build": "npm run build && tsc -p demo && vite build demo",
    "size": "size-limit",
    "perf:lighthouse": "lhci autorun",
    "perf:frames": "node perf/frames.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "basic-ftp": "^6.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
